{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/arbitre-avant-commit.sh\"",
            "timeout": 30,
            "statusMessage": "Arbitre des règles du rugby : vérification avant commit"
          }
        ]
      }
    ]
  }
}
